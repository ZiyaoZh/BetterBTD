<Page x:Class="BetterBTD.Views.Pages.SettingsPageView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d">
    <StackPanel Margin="42,16,42,12">
        <ui:TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="{Binding SoftwareSettingsTitle}" />

        <ui:CardControl Margin="0,0,0,12" Icon="{ui:SymbolIcon Globe24}">
            <ui:CardControl.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Grid.Row="0" Grid.Column="0" FontWeight="SemiBold" Text="{Binding UiLanguageTitle}" TextWrapping="Wrap" />
                    <ui:TextBlock Grid.Row="1" Grid.Column="0" Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" Text="{Binding UiLanguageSubtitle}" TextWrapping="Wrap" />
                    <ComboBox Grid.Row="0"
                              Grid.RowSpan="2"
                              Grid.Column="1"
                              Width="200"
                              Margin="0,0,36,0"
                              DisplayMemberPath="DisplayName"
                              ItemsSource="{Binding UiLanguageOptions}"
                              SelectedItem="{Binding SelectedUiLanguage, Mode=TwoWay}" />
                </Grid>
            </ui:CardControl.Header>
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,12" Icon="{ui:SymbolIcon DarkTheme24}">
            <ui:CardControl.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Grid.Row="0" Grid.Column="0" FontWeight="SemiBold" Text="{Binding ThemeTitle}" TextWrapping="Wrap" />
                    <ui:TextBlock Grid.Row="1" Grid.Column="0" Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" Text="{Binding ThemeSubtitle}" TextWrapping="Wrap" />
                    <ComboBox Grid.Row="0"
                              Grid.RowSpan="2"
                              Grid.Column="1"
                              Width="200"
                              Margin="0,0,36,0"
                              DisplayMemberPath="DisplayName"
                              ItemsSource="{Binding ThemeOptions}"
                              SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" />
                </Grid>
            </ui:CardControl.Header>
        </ui:CardControl>

        <ui:TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="{Binding GameSettingsTitle}" />

        <ui:CardControl Margin="0,0,0,12" Icon="{ui:SymbolIcon LocalLanguage24}">
            <ui:CardControl.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Grid.Row="0" Grid.Column="0" FontWeight="SemiBold" Text="{Binding GameLanguageTitle}" TextWrapping="Wrap" />
                    <ui:TextBlock Grid.Row="1" Grid.Column="0" Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" Text="{Binding GameLanguageSubtitle}" TextWrapping="Wrap" />
                    <ComboBox Grid.Row="0"
                              Grid.RowSpan="2"
                              Grid.Column="1"
                              Width="200"
                              Margin="0,0,36,0"
                              DisplayMemberPath="DisplayName"
                              ItemsSource="{Binding GameLanguageOptions}"
                              SelectedItem="{Binding SelectedGameLanguage, Mode=TwoWay}" />
                </Grid>
            </ui:CardControl.Header>
        </ui:CardControl>

        <ui:CardExpander Margin="0,0,0,12" ContentPadding="0" Icon="{ui:SymbolIcon KeyboardMouse16}">
            <ui:CardExpander.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Grid.Row="0"
                                  Grid.Column="0"
                                  FontWeight="SemiBold"
                                  Text="{Binding KeyboardMouseSimulationTitle}"
                                  TextWrapping="Wrap" />
                    <ui:TextBlock Grid.Row="1"
                                  Grid.Column="0"
                                  Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                  Text="{Binding KeyboardMouseSimulationSubtitle}"
                                  TextWrapping="Wrap" />
                </Grid>
            </ui:CardExpander.Header>
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0"
                        Grid.Column="0"
                        Padding="12"
                        Background="{ui:ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <RadioButton GroupName="KeyboardMouseSimulationMode"
                                     Content="{Binding StandardKeyboardMouseSimulationTitle}"
                                     FontWeight="SemiBold"
                                     IsChecked="{Binding IsStandardKeyboardMouseSimulationModeSelected, Mode=TwoWay}" />
                        <ui:TextBlock Margin="24,6,0,0"
                                      Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                      Text="{Binding StandardKeyboardMouseSimulationDescription}"
                                      TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="0"
                        Grid.Column="2"
                        Padding="12"
                        Background="{ui:ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <RadioButton GroupName="KeyboardMouseSimulationMode"
                                     Content="{Binding HardwareKeyboardMouseSimulationTitle}"
                                     FontWeight="SemiBold"
                                     IsChecked="{Binding IsHardwareKeyboardMouseSimulationModeSelected, Mode=TwoWay}" />
                        <ui:TextBlock Margin="24,6,0,0"
                                      Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                      Text="{Binding HardwareKeyboardMouseSimulationDescription}"
                                      TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <ui:TextBlock Grid.Row="1"
                              Grid.Column="0"
                              Grid.ColumnSpan="3"
                              Margin="0,12,0,0"
                              Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                              Text="{Binding KeyboardMouseSimulationStatusText}"
                              TextWrapping="Wrap" />
            </Grid>
        </ui:CardExpander>

        <ui:CardExpander Margin="0,0,0,12" ContentPadding="0" Icon="{ui:SymbolIcon KeyboardMouse16}">
            <ui:CardExpander.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Grid.Row="0"
                                  Grid.Column="0"
                                  FontWeight="SemiBold"
                                  Text="{Binding KeyBindingsTitle}"
                                  TextWrapping="Wrap" />
                    <ui:TextBlock Grid.Row="1"
                                  Grid.Column="0"
                                  Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                  Text="{Binding KeyBindingsSubtitle}"
                                  TextWrapping="Wrap" />
                    <ui:Button Grid.Row="0"
                               Grid.RowSpan="2"
                               Grid.Column="1"
                               Margin="0,0,20,0"
                               Command="{Binding OpenKeyBindingsWindowCommand}"
                               Content="{Binding ConfigureText}" />
                </Grid>
            </ui:CardExpander.Header>
            <StackPanel>
                <Grid Margin="16">
                    <ui:TextBlock Text="{Binding KeyBindingsBodyText}" TextWrapping="Wrap" />
                </Grid>
            </StackPanel>
        </ui:CardExpander>

        <ui:TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="{Binding AutoTaskSettingsTitle}" />

        <ui:CardExpander Margin="0,0,0,12"
                         ContentPadding="0"
                         Icon="{ui:SymbolIcon ArrowSync24}"
                         IsEnabled="{Binding CanEditSharedSettings}">
            <ui:CardExpander.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:TextBlock Grid.Row="0" FontWeight="SemiBold" Text="{Binding AutoTaskRecoveryTitle}" TextWrapping="Wrap" />
                    <ui:TextBlock Grid.Row="1"
                                  Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                  Text="{Binding AutoTaskRecoverySubtitle}"
                                  TextWrapping="Wrap" />
                </Grid>
            </ui:CardExpander.Header>

            <StackPanel>
                <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Grid.Row="0" FontWeight="SemiBold" Text="{Binding AutoTaskNavigationFailureLimitTitle}" TextWrapping="Wrap" />
                    <ui:TextBlock Grid.Row="1" Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" Text="{Binding AutoTaskNavigationFailureLimitSubtitle}" TextWrapping="Wrap" />
                    <ui:NumberBox Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Width="120" Margin="12,0,36,0"
                                  Minimum="1" Maximum="20" SmallChange="1" MaxDecimalPlaces="0"
                                  Value="{Binding AutoTaskMaxConsecutiveNavigationFailures, Mode=TwoWay}" />
                </Grid>

                <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Grid.Row="0" FontWeight="SemiBold" Text="{Binding AutoTaskStuckTimeoutTitle}" TextWrapping="Wrap" />
                    <ui:TextBlock Grid.Row="1" Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" Text="{Binding AutoTaskStuckTimeoutSubtitle}" TextWrapping="Wrap" />
                    <ui:NumberBox Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Width="120" Margin="12,0,36,0"
                                  Minimum="1" Maximum="300" SmallChange="1" MaxDecimalPlaces="0"
                                  Value="{Binding AutoTaskStuckUiTimeoutSeconds, Mode=TwoWay}" />
                </Grid>

                <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Grid.Row="0" FontWeight="SemiBold" Text="{Binding AutoTaskVisualToleranceTitle}" TextWrapping="Wrap" />
                    <ui:TextBlock Grid.Row="1" Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" Text="{Binding AutoTaskVisualToleranceSubtitle}" TextWrapping="Wrap" />
                    <ui:NumberBox Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Width="120" Margin="12,0,36,0"
                                  Minimum="0" Maximum="64" SmallChange="1" MaxDecimalPlaces="0"
                                  Value="{Binding AutoTaskVisualFingerprintDistanceTolerance, Mode=TwoWay}" />
                </Grid>

                <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Grid.Row="0" FontWeight="SemiBold" Text="{Binding AutoTaskRecoveryDelayTitle}" TextWrapping="Wrap" />
                    <ui:TextBlock Grid.Row="1" Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" Text="{Binding AutoTaskRecoveryDelaySubtitle}" TextWrapping="Wrap" />
                    <ui:NumberBox Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Width="120" Margin="12,0,36,0"
                                  Minimum="0" Maximum="10000" SmallChange="100" MaxDecimalPlaces="0"
                                  Value="{Binding AutoTaskStuckRecoveryDelayMs, Mode=TwoWay}" />
                </Grid>

                <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                <StackPanel Margin="16">
                    <ui:TextBlock FontWeight="SemiBold" Text="{Binding AutoTaskRecoveryPointsTitle}" TextWrapping="Wrap" />
                    <ui:TextBlock Margin="0,2,0,10" Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" Text="{Binding AutoTaskRecoveryPointsSubtitle}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding AutoTaskStuckRecoveryPoints}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBlock VerticalAlignment="Center" Text="{Binding DataContext.AutoTaskRecoveryPointXLabel, RelativeSource={RelativeSource AncestorType=Page}}" />
                                    <ui:NumberBox Grid.Column="1" Margin="8,0,16,0" Minimum="0" Maximum="1919" SmallChange="1" MaxDecimalPlaces="0" Value="{Binding X, Mode=TwoWay}" />
                                    <ui:TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding DataContext.AutoTaskRecoveryPointYLabel, RelativeSource={RelativeSource AncestorType=Page}}" />
                                    <ui:NumberBox Grid.Column="3" Margin="8,0,12,0" Minimum="0" Maximum="1079" SmallChange="1" MaxDecimalPlaces="0" Value="{Binding Y, Mode=TwoWay}" />
                                    <ui:Button Grid.Column="4"
                                               Command="{Binding DataContext.RemoveAutoTaskRecoveryPointCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                               CommandParameter="{Binding}"
                                               Icon="{ui:SymbolIcon Delete24}"
                                               ToolTip="{Binding DataContext.RemoveAutoTaskRecoveryPointText, RelativeSource={RelativeSource AncestorType=Page}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ui:Button HorizontalAlignment="Left"
                               Appearance="Secondary"
                               Command="{Binding AddAutoTaskRecoveryPointCommand}"
                               Content="{Binding AddAutoTaskRecoveryPointText}"
                               Icon="{ui:SymbolIcon Add24}" />
                </StackPanel>
            </StackPanel>
        </ui:CardExpander>

        <ui:TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="{Binding HelpTitle}" />

        <ui:CardExpander Margin="0,0,0,12" ContentPadding="0" Icon="{ui:SymbolIcon ArrowDownload24}">
            <ui:CardExpander.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Grid.Row="0" Grid.Column="0" FontWeight="SemiBold" Text="{Binding CardUpdateTitle}" TextWrapping="Wrap" />
                    <ui:TextBlock Grid.Row="1" Grid.Column="0" Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" Text="{Binding CardUpdateDescription}" TextWrapping="Wrap" />
                    <ui:Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="0,0,20,0" Command="{Binding CheckUpdateCommand}" Content="{Binding CheckUpdateText}" />
                </Grid>
            </ui:CardExpander.Header>
            <StackPanel>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:TextBlock Grid.Row="0"
                                  Margin="0,0,0,8"
                                  Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                  Text="{Binding CurrentVersionText}"
                                  TextWrapping="Wrap" />
                    <ui:TextBlock Grid.Row="1"
                                  Margin="0,12,0,0"
                                  Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                  Text="{Binding UpdateStatusText}"
                                  TextWrapping="Wrap" />
                </Grid>
            </StackPanel>
        </ui:CardExpander>

        <ui:CardControl Margin="0,0,0,12" Icon="{ui:SymbolIcon Info24}">
            <ui:CardControl.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Grid.Row="0" Grid.Column="0" FontWeight="SemiBold" Text="{Binding CardAboutTitle}" TextWrapping="Wrap" />
                    <ui:TextBlock Grid.Row="1" Grid.Column="0" Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" Text="{Binding CardAboutDescription}" TextWrapping="Wrap" />
                    <ui:Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="0,0,36,0" Command="{Binding OpenAboutCommand}" Content="{Binding OpenText}" />
                </Grid>
            </ui:CardControl.Header>
        </ui:CardControl>
    </StackPanel>
</Page>
