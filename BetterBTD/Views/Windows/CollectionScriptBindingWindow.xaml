<ui:FluentWindow x:Class="BetterBTD.Views.Windows.CollectionScriptBindingWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 mc:Ignorable="d"
                 Title="{Binding WindowTitle}"
                 Width="960"
                 Height="700"
                 MinWidth="760"
                 MinHeight="520"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding WindowTitle}">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Settings24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ui:TextBlock Grid.Row="1"
                      Margin="32,12,32,12"
                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                      Text="{Binding PageDescription}"
                      TextWrapping="Wrap" />

        <TabControl Grid.Row="2"
                    Margin="32,0,32,12"
                    ItemsSource="{Binding Modes}"
                    SelectedItem="{Binding SelectedMode, Mode=TwoWay}">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayName}" />
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Margin="4,0,0,8"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="{Binding ConfiguredCountText}" />
                        <Grid Grid.Row="1" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Margin="12,4"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Text="{Binding DataContext.MapHeader, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}" />
                            <TextBlock Grid.Column="1"
                                       Margin="12,4"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Text="{Binding DataContext.ScriptHeader, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}" />
                        </Grid>
                        <DataGrid Grid.Row="2"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserResizeRows="False"
                                  HeadersVisibility="None"
                                  ItemsSource="{Binding Rows}"
                                  RowHeaderWidth="0"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow">
                            <DataGrid.Resources>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="220"
                                                    Binding="{Binding MapDisplayName}"
                                                    IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox Margin="8,4"
                                                      Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                      DisplayMemberPath="DisplayText"
                                                      IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                                      IsTextSearchEnabled="True"
                                                      ItemsSource="{Binding ScriptChoices}"
                                                      SelectedItem="{Binding SelectedScript, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      TextSearch.TextPath="DisplayText" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>

        <Grid Grid.Row="3" Margin="32,0,32,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center"
                       Text="{Binding CopyFromLabel}" />
            <ComboBox Grid.Column="1"
                      Margin="0,0,8,0"
                      Background="{DynamicResource ControlFillColorSecondaryBrush}"
                      DisplayMemberPath="DisplayName"
                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                      IsEnabled="{Binding CanEdit}"
                      ItemsSource="{Binding CopySourceModes}"
                      SelectedItem="{Binding CopySourceMode, Mode=TwoWay}" />
            <ui:Button Grid.Column="2"
                       Margin="0,0,8,0"
                       Appearance="Secondary"
                       Command="{Binding CopyModeCommand}"
                       Content="{Binding CopyText}"
                       Icon="{ui:SymbolIcon Copy24}" />
            <ui:Button Grid.Column="3"
                       Appearance="Secondary"
                       Command="{Binding ClearModeCommand}"
                       Content="{Binding ClearText}"
                       Icon="{ui:SymbolIcon Delete24}" />

            <TextBlock Grid.Column="4"
                       Margin="16,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="{Binding StatusText}"
                       TextTrimming="CharacterEllipsis" />

            <ui:Button Grid.Column="5"
                       Margin="0,0,8,0"
                       Appearance="Secondary"
                       Command="{Binding CloseCommand}"
                       Content="{Binding CancelText}" />
            <ui:Button Grid.Column="6"
                       Appearance="Primary"
                       Command="{Binding SaveCommand}"
                       Content="{Binding SaveText}"
                       Icon="{ui:SymbolIcon Save24}" />
        </Grid>
    </Grid>
</ui:FluentWindow>
